# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Environment variables (SECRETS - never commit) ────────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local
# .env.example is safe to commit (has no real secrets)

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# ── Build / Upload ─────────────────────────────────────────────────────────────
dist/
build/
uploads/        # multer upload folder
tmp/

# ── Secrets ───────────────────────────────────────────────────────────────────
*.pem
*.p12
*.key
*.cert
