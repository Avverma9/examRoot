# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/examRoot
# For MongoDB Atlas, use: mongodb+srv://username:password@cluster.mongodb.net/examRoot

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345

# Email Configuration (Gmail)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-from-gmail

# For using other email services like SendGrid, Mailtrap, etc.
# EMAIL_SERVICE=SendGrid
# EMAIL_USER=apikey
# EMAIL_PASSWORD=sg_your_sendgrid_api_key

# SMTP Configuration (if using custom SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000
MOBILE_APP_URL=exp://localhost:8081

# API Configuration
API_BASE_URL=http://localhost:3000/api

# OTP Configuration
OTP_VALIDITY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Database
DB_HOST=localhost
DB_PORT=27017
DB_NAME=examRoot
