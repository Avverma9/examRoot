# ─────────────────────────────────────────────────────────────────────────────
# ExamRoot Server — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# NODE_ENV=production   ← change this when deploying

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local:
# MONGO_URI=mongodb://localhost:27017/examRoot
# Atlas (replace username, password, cluster URL):
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/examRoot?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong random string, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_min_32_chars

# ── Email (Gmail + App Password) ─────────────────────────────────────────────
# Step 1: Enable 2-Step Verification on your Google account
# Step 2: Go to Google Account → Security → App Passwords → create one for "ExamRoot"
# Step 3: Paste the 16-character app password below (spaces are fine)
EMAIL_SERVICE=gmail
EMAIL_USER=yourapp@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ── Cashfree Payment Gateway ──────────────────────────────────────────────────
# Get from: https://merchant.cashfree.com → Developer Options → API Keys
# Use TEST keys for development, LIVE keys for production
CASHFREE_APP_ID=TEST<your_app_id_here>
CASHFREE_SECRET_KEY=<your_secret_key_here>

# ── Server Public URL ─────────────────────────────────────────────────────────
# Used as Cashfree webhook notify_url
# Development: use ngrok → run: ngrok http 3000 → paste the https URL below
# Production: your actual domain, e.g. https://api.examroot.in
SERVER_URL=https://xxxx-xx-xx-xxx-xx.ngrok-free.app

# ── Mobile App Deep Link ──────────────────────────────────────────────────────
# Cashfree redirects here after payment (must match scheme in app.json)
APP_RETURN_URL=examroot://payment

# ── OTP Settings ─────────────────────────────────────────────────────────────
OTP_VALIDITY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Fast2SMS (SMS OTP) ────────────────────────────────────────────────────────
# Get API key from: https://www.fast2sms.com/dashboard/dev-api
# Uses Quick SMS route (no DLT required) — OTP managed by our server
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Web client ID (used by Expo/web OAuth flow)
GOOGLE_CLIENT_ID=your_web_client_id_here.apps.googleusercontent.com
# Android client ID (used by native Android Google Sign-In)
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id_here.apps.googleusercontent.com
