# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Environment variables (SECRETS - never commit) ────────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env.*.local
# .env.example is safe to commit (template without real values)

# ── Expo ──────────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ── Native generated folders ──────────────────────────────────────────────────
# Uncomment below if you don't want to commit native folders
# /android
# /ios

# ── Android build artifacts ───────────────────────────────────────────────────
android/build/
android/.gradle/
android/.idea/
android/local.properties
android/.cxx/
android/app/build/
android/app/.cxx/
android/.kotlin/

# ── iOS ───────────────────────────────────────────────────────────────────────
ios/Pods/
ios/build/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/

# ── Native keys / certs ───────────────────────────────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ── Metro ─────────────────────────────────────────────────────────────────────
.metro-health-check*

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.pem

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo

# ── EAS ───────────────────────────────────────────────────────────────────────
.easignore
